<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    >


    <!-- 뒤로가기 버튼 -->
    <ImageView
        android:id="@+id/album_back_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/btn_arrow_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"/>

    <!-- 앨범명 -->
    <TextView
        android:id="@+id/album_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lost corner"
        android:textStyle="bold"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="69dp"/>

    <!-- 아티스트명 -->
    <TextView
        android:id="@+id/album_artist_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kenshi Yonezu"
        android:textSize="14sp"
        android:textColor="@color/gray"
        app:layout_constraintTop_toBottomOf="@id/album_title_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp"/>

    <!-- 앨범 정보 -->
    <TextView
        android:id="@+id/album_info_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="앨범정보"
        android:textSize="13sp"
        android:textColor="@color/gray"
        app:layout_constraintTop_toBottomOf="@id/album_artist_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp"/>

    <!-- 앨범 커버 이미지 -->
    <ImageView
        android:id="@+id/album_cover_iv"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/img_album_lost"
        app:layout_constraintTop_toBottomOf="@id/album_info_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- 우상단 좋아요 버튼 -->
    <ImageView
        android:id="@+id/album_like_btn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_my_like_off"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="65dp"/>

    <!-- 우상단 더보기 버튼 -->
    <ImageView
        android:id="@+id/album_more_btn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/btn_player_more"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>

