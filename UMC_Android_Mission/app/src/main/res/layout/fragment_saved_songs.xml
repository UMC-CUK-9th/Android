<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:id="@+id/locker_song_check_iv"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/btn_playlist_select_off"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="7dp"/>


    <TextView
        android:id="@+id/locker_song_check_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="전체 선택"
        android:textColor="@color/gray"
        android:textSize="17sp"
        app:layout_constraintStart_toEndOf="@+id/locker_song_check_iv"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="10dp"/>

    <ImageView
        android:id="@+id/locker_song_listen_iv"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/icon_browse_arrow_right"
        app:layout_constraintStart_toEndOf="@+id/locker_song_check_tv"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="7dp"/>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="전체 듣기"
        android:textColor="@color/gray"
        android:textSize="17sp"
        app:layout_constraintStart_toEndOf="@+id/locker_song_listen_iv"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="편집"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="10dp"/>
    




</androidx.constraintlayout.widget.ConstraintLayout>