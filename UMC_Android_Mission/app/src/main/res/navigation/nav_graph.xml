<?xml version="1.0" encoding="utf-8"?>

<navigation xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/nav_graph"
app:startDestination="@id/homeFragment"
    >

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.umc_android_mission2.HomeFragment"
        android:label="홈"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_albumFragment"
            app:destination="@id/albumFragment" />
    </fragment>

<fragment
    android:id="@+id/albumFragment"
    android:name="com.example.umc_android_mission2.AlbumFragment"
    android:label="앨범"
    tools:layout="@layout/fragment_album" >

    <argument
        android:name="albumId"
        app:argType="integer" />

</fragment>
    

<fragment
    android:id="@+id/searchFragment"
    android:name="com.example.umc_android_mission2.SearchFragment"
    android:label="검색"
     />
    
    

<fragment
    android:id="@+id/lockerFragment"
    android:name="com.example.umc_android_mission2.LockerFragment"
    android:label="보관함"
    tools:layout="@layout/fragment_locker" />

    <fragment
        android:id="@+id/lookFragment"
        android:name="com.example.umc_android_mission2.LookFragment"
        android:label="둘러보기"
        tools:layout="@layout/fragment_look" />


</navigation>